{
  "name": "mindbridge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MindBridge — 面向小鼠 mPFC 神经信号的智能仿真与分析系统（Web 前端）",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.mjs",
    "dev:full": "concurrently -k \"npm:dev:server\" \"npm:dev\"",
    "build": "vue-tsc -b && vite build",
    "build:pages": "vue-tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "echarts": "^5.5.1",
    "express": "^5.1.0",
    "lucide-react": "file:vendor/lucide-react-1.41.0.tgz",
    "papaparse": "^5.7.0",
    "pinia": "^2.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "4.3.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}

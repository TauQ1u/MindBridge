# 可选：数据根目录；留空时使用仓库内 server/data。
# 自定义目录应包含 experiments/、analyses/ 与 reports/。
MINDBRIDGE_DATA_ROOT=
MINDBRIDGE_STATE_ROOT=
MINDBRIDGE_PIPELINE_PROVIDER=precomputed
PORT=3001

# Browser API prefix. Same-origin production uses /api.
VITE_API_BASE_URL=/api
# GitHub Pages builds: set VITE_API_BASE_URL to the deployed backend API origin + /api.
# Example: https://api.example.com/api
VITE_BASE_PATH=/

# ---- 账号与安全 ----
# 管理员用户名（系统仅预置这一个账号）
MINDBRIDGE_ADMIN_USER=admin
# 密码哈希，运行 node scripts/hash-password.mjs <密码> 生成后粘贴到此处；
# 留空时使用内置默认口令 MindBridge@2026（仅限本地调试，生产必须修改）
MINDBRIDGE_ADMIN_PASSWORD_HASH=
# 会话签名密钥：随机长字符串；留空则每次启动随机生成（重启后所有会话失效）
MINDBRIDGE_SESSION_SECRET=
# HTTPS 部署时置 1，会话 Cookie 仅经加密通道传输
MINDBRIDGE_SECURE_COOKIE=0
# Comma-separated exact browser origins allowed to call this backend (required for Pages).
MINDBRIDGE_ALLOWED_ORIGINS=
